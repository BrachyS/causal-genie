# Copy to .env (gitignored) and fill in. Never commit real keys.

# Nebius Token Factory (OpenAI-compatible API); confirm the base URL in T2
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily search + extract
TAVILY_API_KEY=

# 1 = allow the humor gate to run (off by default)
GENIE_MODE=0

# 1 = replay recorded runs; no keys needed
CG_REPLAY=0
